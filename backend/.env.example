# ============================================================
# 夜读文库 · 后端环境变量模板
# 用法：cp .env.example .env  （本地开发）
#      或在 Railway / Zeabur / 宝塔等平台的环境变量面板里逐条填写
# ============================================================

# ---------- 服务 ----------
NODE_ENV=production
PORT=3000
API_PREFIX=/api

# ---------- CORS ----------
# 同域部署（Nginx 反代 / Vercel rewrites）→ 保持 "*" 即可
# 前端独立域名部署 → 填前端地址，如 https://read.yourdomain.com
# 注意：填具体域名时才会启用 credentials，且必须与前端 origin 完全一致
CORS_ORIGIN=*

# ---------- 日志 ----------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---------- 数据持久化 ----------
# 订单与阅读进度写入该目录下的 store.json
# 容器部署必须指向已挂载的持久卷，否则重建容器会丢数据
DATA_DIR=/app/data
