# 依赖与构建产物
node_modules/
**/node_modules/
dist/
**/dist/
build/

# 运行时数据（订单、阅读进度）——不应进镜像也不应进 Git
backend/data/
*.log

# 环境变量（只保留 .env.example）
.env
.env.*
!.env.example

# 编辑器 / IDE
.vscode/
.idea/
.DS_Store

# 工具链缓存
.codebuddy/
.genie/
.templates/
.cloudstudio
.cache/

# 版本控制
.git/
.gitignore

# 文档与说明（不影响运行，减小镜像体积）
docs/
*.md
!README.md

# 压缩包
*.zip
*.tar.gz
